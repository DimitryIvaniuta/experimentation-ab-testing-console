{
  "name": "ab-testing-platform-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-grade React 19.2 admin console for the Experimentation / A-B Testing Platform backend.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:prod": "npm audit --omit=dev",
    "validate": "npm run build && npm run test && npm run audit:prod",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "7.15.1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/browser": "4.1.6",
    "jsdom": "27.2.0",
    "typescript": "6.0.3",
    "vite": "8.0.13",
    "vitest": "4.1.6"
  },
  "overrides": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  }
}
