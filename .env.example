# Empty value means the UI uses same-origin /api and /actuator paths.
# In local Vite dev this is proxied to http://localhost:8080 by vite.config.ts.
VITE_API_BASE_URL=
VITE_DEFAULT_EXPERIMENT_KEY=checkout_button_color

# Optional. Leave empty in production and use Settings page or OIDC/API-gateway auth.
# Dev builds fall back to local-admin-token only when this value is empty.
VITE_DEFAULT_ADMIN_TOKEN=

# Optional request timeout. Allowed range: 1000..60000 ms.
VITE_REQUEST_TIMEOUT_MS=15000
